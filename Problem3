total_bonus = 0

file = open("employees.py", "r")

last_name = file.readline()
last_name = last_name.strip()

while last_name != "":
    
    salary = file.readline()
    salary = float(salary)

    if salary >= 100000:
        bonus_rate = 0.20
    elif salary >= 50000:
        bonus_rate = 0.15
    else:
        bonus_rate = 0.10

    bonus = salary * bonus_rate

    print("Last Name:", last_name)
    print("Salary: $", format(salary, ".2f"))
    print("Bonus: $", format(bonus, ".2f"))
    print()

    total_bonus = total_bonus + bonus

    last_name = file.readline()
    last_name = last_name.strip()

file.close()

print("Total bonuses paid: $", format(total_bonus, ".2f"))
